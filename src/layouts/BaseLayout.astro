---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BotonWhatsApp from "../components/BotonWhatsApp.astro";
import { SITIO } from "../data/sitio";
import { url } from "../lib/rutas";

interface Props {
  titulo?: string;
  descripcion?: string;
}
const { titulo, descripcion = SITIO.descripcion } = Astro.props;
const tituloCompleto = titulo
  ? `${titulo} | ${SITIO.nombre}`
  : `${SITIO.nombre} | ${SITIO.eslogan}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />

    <!-- Datos para cuando se comparte el enlace en WhatsApp, redes, etc. -->
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <BotonWhatsApp />
  </body>
</html>
