---
import Logo from "./Logo.astro";
import { url } from "../lib/rutas";
import { enlaceWhatsApp } from "../data/sitio";

const enlaces = [
  { texto: "Inicio", href: url("/") },
  { texto: "Catálogo", href: url("/catalogo/") },
  { texto: "Línea industrial", href: url("/linea-industrial/") },
  { texto: "Nosotros", href: url("/nosotros/") },
  { texto: "Contacto", href: url("/contacto/") },
];

// Marca como activo el enlace de la página actual
const conBarra = (ruta: string) => (ruta.endsWith("/") ? ruta : `${ruta}/`);
const actual = conBarra(Astro.url.pathname);
const inicio = conBarra(url("/"));
const esActivo = (href: string) =>
  href === inicio ? actual === inicio : actual.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-white/10 bg-tinta/90 text-white backdrop-blur"
>
  <div
    class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6"
  >
    <a href={url("/")} aria-label="Lukebag, ir al inicio">
      <Logo />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class:list={[
              "text-sm font-medium transition hover:text-white",
              esActivo(e.href) ? "text-white" : "text-neutral-400",
            ]}
          >
            {e.texto}
          </a>
        ))
      }
      <a
        href={enlaceWhatsApp()}
        target="_blank"
        rel="noopener"
        class="boton-primario py-2">Cotizar</a
      >
    </nav>

    <button
      id="boton-menu"
      class="rounded-md p-2 text-neutral-300 hover:text-white md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-movil"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav
    id="menu-movil"
    class="hidden border-t border-white/10 px-4 pb-4 md:hidden"
    aria-label="Menú móvil"
  >
    {
      enlaces.map((e) => (
        <a
          href={e.href}
          class="block border-b border-white/5 py-3 text-neutral-300 hover:text-white"
        >
          {e.texto}
        </a>
      ))
    }
    <a
      href={enlaceWhatsApp()}
      target="_blank"
      rel="noopener"
      class="boton-primario mt-4 w-full">Cotizar por WhatsApp</a
    >
  </nav>
</header>

<script>
  const boton = document.getElementById("boton-menu");
  const menu = document.getElementById("menu-movil");
  boton?.addEventListener("click", () => {
    const abierto = menu?.classList.toggle("hidden") === false;
    boton.setAttribute("aria-expanded", String(abierto));
  });
</script>
