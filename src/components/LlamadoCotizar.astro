---
import { enlaceWhatsApp } from "../data/sitio";
import { url } from "../lib/rutas";

interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = "¿Tienes un proyecto en mente?",
  texto = "Cuéntanos qué necesitas, las medidas y cantidades. Te respondemos con una cotización.",
} = Astro.props;
---

<section class="bg-marca text-white">
  <div
    class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between"
  >
    <div>
      <h2 class="font-display text-3xl font-bold">{titulo}</h2>
      <p class="mt-2 max-w-2xl text-white/85">{texto}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a
        href={enlaceWhatsApp()}
        target="_blank"
        rel="noopener"
        class="boton bg-tinta text-white hover:bg-black"
      >
        Escribir por WhatsApp
      </a>
      <a
        href={url("/contacto/")}
        class="boton border border-white/60 text-white hover:bg-white hover:text-marca"
      >
        Ver más opciones
      </a>
    </div>
  </div>
</section>
