---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import EncabezadoPagina from "../components/EncabezadoPagina.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import LlamadoCotizar from "../components/LlamadoCotizar.astro";
import { productosDe } from "../data/catalogo";
import { enlaceWhatsApp } from "../data/sitio";
import fotoIndustrial from "../assets/sitio/industrial.webp";

const amenazas = [
  {
    titulo: "Corrosión salina",
    texto:
      "La niebla marina deposita sal sobre metales y componentes eléctricos, acelerando su deterioro",
  },
  {
    titulo: "Radiación UV",
    texto:
      "El sol degrada plásticos, cables, pinturas y sellos de los equipos que trabajan a la intemperie",
  },
  {
    titulo: "Lluvia y humedad",
    texto:
      "El agua y la condensación provocan oxidación, cortocircuitos y fallas prematuras",
  },
  {
    titulo: "Polvo y abrasión",
    texto:
      "En faena, el polvo y las partículas desgastan piezas móviles y filtros",
  },
];

const industrias = [
  "Puertos y terminales marítimos",
  "Acuicultura y pesca",
  "Minería",
  "Energía y generación",
  "Plantas desaladoras",
  "Construcción",
  "Agroindustria",
  "Transporte",
];
---

<BaseLayout
  titulo="Línea industrial"
  descripcion="Fundas y cubiertas a medida para proteger maquinaria y equipos industriales de la corrosión salina, el sol, la humedad y el polvo."
>
  <EncabezadoPagina
    etiqueta="Línea industrial"
    titulo="Protección a medida para equipos en entornos extremos"
    bajada="Diseñamos y fabricamos fundas para maquinaria e instalaciones expuestas a la sal, el sol, la lluvia y el polvo. Cada funda se hace según las medidas exactas de tu equipo."
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={enlaceWhatsApp(
          "Hola Lukebag, necesito cotizar una funda industrial.",
        )}
        target="_blank"
        rel="noopener"
        class="boton-primario"
      >
        Cotizar una funda
      </a>
    </div>
  </EncabezadoPagina>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <p class="etiqueta">El problema</p>
    <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold md:text-4xl">
      El entorno desgasta tus equipos todos los días
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        amenazas.map((a, i) => (
          <div class="rounded-2xl border border-neutral-200 p-6">
            <span class="font-display text-sm font-semibold text-marca">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 font-display text-lg font-bold">{a.titulo}</h3>
            <p class="mt-2 text-sm text-neutral-600">{a.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-tinta text-white">
    <div
      class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2"
    >
      <div>
        <p class="etiqueta">La solución</p>
        <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">
          Fundas hechas para tu equipo, no genéricas
        </h2>
        <ol class="mt-8 space-y-6">
          <li class="flex gap-4">
            <span class="font-display text-2xl font-bold text-marca">01</span>
            <div>
              <h3 class="font-semibold">Levantamiento</h3><p
                class="text-sm text-neutral-400"
              >
                Tomamos medidas en terreno o trabajamos con tus planos y fotos
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-display text-2xl font-bold text-marca">02</span>
            <div>
              <h3 class="font-semibold">Material adecuado</h3><p
                class="text-sm text-neutral-400"
              >
                Elegimos la tela técnica según el riesgo: sal, UV, químicos o
                corrosión
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="font-display text-2xl font-bold text-marca">03</span>
            <div>
              <h3 class="font-semibold">Detalles funcionales</h3><p
                class="text-sm text-neutral-400"
              >
                Ventanas de inspección, accesos con cierre, ventilación y
                anclajes
              </p>
            </div>
          </li>
        </ol>
      </div>
      <div class="overflow-hidden rounded-2xl border border-white/10">
        <Image
          src={fotoIndustrial}
          alt="Funda industrial instalada"
          widths={[600, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <p class="etiqueta">Productos</p>
    <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">
      Soluciones industriales
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {productosDe("industrial").map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </section>

  <section class="bg-neutral-100">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-2xl font-bold">Industrias que atendemos</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          industrias.map((i) => (
            <li class="rounded-full border border-neutral-300 bg-white px-4 py-2 text-sm">
              {i}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <LlamadoCotizar
    titulo="Protege tus equipos antes de que falle algo"
    texto="Envíanos fotos y medidas aproximadas del equipo y te asesoramos sin costo."
  />
</BaseLayout>
