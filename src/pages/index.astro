---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import LlamadoCotizar from "../components/LlamadoCotizar.astro";
import { categorias, productos, productosDe } from "../data/catalogo";
import { enlaceWhatsApp } from "../data/sitio";
import { foto } from "../lib/fotos";
import { url } from "../lib/rutas";
import fotoIndustrial from "../assets/sitio/industrial.webp";

const destacados = productos.filter((p) => p.destacado);

const ventajas = [
  {
    titulo: "100% a medida",
    texto: "Diseñamos cada pieza según tus medidas y usos",
  },
  {
    titulo: "Tu marca",
    texto: "Bordado o estampado con el logo de tu empresa",
  },
  {
    titulo: "Materiales técnicos",
    texto: "Telas resistentes al agua, a la sal, al sol y al roce",
  },
  {
    titulo: "Fabricación local",
    texto: "Producción 100% chilena, con seguimiento directo de tu pedido",
  },
];

const pasos = [
  {
    n: "01",
    titulo: "Nos cuentas",
    texto: "Qué necesitas, medidas, cantidades y dónde se usará",
  },
  {
    n: "02",
    titulo: "Diseñamos",
    texto: "Proponemos materiales, diseño y personalización",
  },
  {
    n: "03",
    titulo: "Fabricamos",
    texto: "Confeccionamos en nuestro taller con control de calidad",
  },
  {
    n: "04",
    titulo: "Entregamos",
    texto: "Despacho o instalación, listo para usar",
  },
];
---

<BaseLayout>
  <!-- ============ PORTADA ============ -->
  <section class="fondo-grilla relative overflow-hidden bg-tinta text-white">
    <div
      class="absolute top-1/2 -left-40 h-96 w-96 -translate-y-1/2 rounded-full bg-marca/15 blur-3xl"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 md:py-28 lg:grid-cols-2"
    >
      <div>
        <p class="etiqueta">Textil Industrial a medida</p>
        <h1
          class="mt-4 font-display text-5xl leading-[1.05] font-bold tracking-tight md:text-6xl"
        >
          Confección que <span class="text-marca">protege</span> lo que importa
        </h1>
        <p class="mt-6 max-w-xl text-lg text-neutral-300">
          Bolsos, mochilas y bananos con la identidad de tu empresa. Fundas
          industriales que resisten la corrosión salina, el sol y los entornos
          más exigentes.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={enlaceWhatsApp()}
            target="_blank"
            rel="noopener"
            class="boton-primario">Cotizar por WhatsApp</a
          >
          <a href={url("/catalogo/")} class="boton-secundario">Ver catálogo</a>
        </div>
      </div>

      <!-- Composición inspirada en el logo -->
      <div
        class="relative mx-auto aspect-square w-full max-w-md"
        aria-hidden="true"
      >
        <div class="absolute inset-0 rounded-4xl border-2 border-marca/70">
        </div>
        <div class="absolute inset-4 grid grid-cols-2 gap-4">
          <a
            href={url("/catalogo/")}
            class="row-span-2 flex flex-col justify-end rounded-2xl border border-white/10 bg-tinta-3 p-6 transition hover:border-white/40"
          >
            <span class="font-display text-sm text-neutral-400">Línea</span>
            <span class="font-display text-2xl font-bold">Textil</span>
          </a>
          <a
            href={url("/linea-industrial/")}
            class="flex flex-col justify-end rounded-2xl bg-marca p-6 transition hover:bg-marca-oscuro"
          >
            <span class="font-display text-sm text-white/80">Línea</span>
            <span class="font-display text-2xl font-bold">Industrial</span>
          </a>
          <a
            href={url("/contacto/")}
            class="flex flex-col justify-end rounded-2xl border border-white/10 bg-tinta-3 p-6 transition hover:border-white/40"
          >
            <span class="font-display text-2xl font-bold">Contáctanos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VENTAJAS ============ -->
  <section class="border-b border-neutral-200">
    <div
      class="mx-auto grid max-w-7xl gap-px bg-neutral-200 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        ventajas.map((v) => (
          <div class="bg-white p-8">
            <div class="h-1 w-8 bg-marca" />
            <h2 class="mt-5 font-display text-lg font-bold">{v.titulo}</h2>
            <p class="mt-2 text-sm text-neutral-600">{v.texto}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ CATEGORÍAS ============ -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="etiqueta">Catálogo</p>
        <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">
          ¿Qué necesitas?
        </h2>
      </div>
      <a href={url("/catalogo/")} class="boton-oscuro">Ver todo el catálogo</a>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categorias.map((c, i) => {
          const primero = productosDe(c.slug)[0];
          return (
            <a
              href={url(`/catalogo/${c.slug}/`)}
              class="group relative flex aspect-4/3 flex-col justify-end overflow-hidden rounded-2xl bg-tinta p-6 text-white"
            >
              {primero && (
                <Image
                  src={foto(primero.foto)}
                  alt=""
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="absolute inset-0 h-full w-full object-cover opacity-60 transition duration-500 group-hover:scale-105 group-hover:opacity-40"
                />
              )}
              <div class="absolute inset-0 bg-linear-to-t from-black via-black/40 to-transparent" />
              <span class="relative font-display text-sm text-marca">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="relative mt-1 font-display text-2xl font-bold">
                {c.nombre}
              </h3>
              <p class="relative mt-1 text-sm text-neutral-300">
                {c.descripcion}
              </p>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ============ LÍNEA INDUSTRIAL ============ -->
  <section class="bg-tinta text-white">
    <div
      class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-2"
    >
      <div class="overflow-hidden rounded-2xl border border-white/10">
        <Image
          src={fotoIndustrial}
          alt="Funda industrial instalada en terreno"
          widths={[600, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
      </div>
      <div>
        <p class="etiqueta">Línea industrial</p>
        <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">
          Fundas que resisten el mar, el sol y la faena
        </h2>
        <p class="mt-5 text-neutral-300">
          Fabricamos fundas a medida para motores, generadores, tableros,
          válvulas y maquinaria expuesta a ambientes agresivos, tales como el
          polvo o la corrosión.
        </p>
        <ul class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
          {
            [
              "Protección anticorrosión",
              "Filtro UV e ignífugo",
              "Repelentes al agua",
              "Fabricadas según plano",
            ].map((t) => (
              <li class="flex items-center gap-3 rounded-lg border border-white/10 px-4 py-3">
                <span class="h-2 w-2 bg-marca" />
                {t}
              </li>
            ))
          }
        </ul>
        <a href={url("/linea-industrial/")} class="boton-primario mt-8"
          >Conocer la línea industrial</a
        >
      </div>
    </div>
  </section>

  <!-- ============ DESTACADOS ============ -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
    <p class="etiqueta">Destacados</p>
    <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">
      Productos más solicitados
    </h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {destacados.map((p) => <TarjetaProducto producto={p} />)}
    </div>
  </section>

  <!-- ============ PROCESO ============ -->
  <section class="bg-neutral-100">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <p class="etiqueta">Cómo trabajamos</p>
      <h2 class="mt-3 font-display text-3xl font-bold md:text-4xl">
        De la idea al producto terminado
      </h2>
      <ol class="mt-10 grid gap-6 md:grid-cols-4">
        {
          pasos.map((p) => (
            <li class="rounded-2xl bg-white p-6">
              <span class="font-display text-4xl font-bold text-marca">
                {p.n}
              </span>
              <h3 class="mt-4 font-display text-lg font-bold">{p.titulo}</h3>
              <p class="mt-2 text-sm text-neutral-600">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <LlamadoCotizar />
</BaseLayout>
